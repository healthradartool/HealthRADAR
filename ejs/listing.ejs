<!--
  - grid: Enables the layout system.
  - gap-2: Creates a consistent space between all grid items,
    both horizontally on desktop AND vertically on mobile.
  - align-items-end: Vertically aligns columns on desktop.
  - mb-4: Margin below the bar.
-->
<div class="grid gap-2 align-items-end mb-4">

  <!-- For each dropdown, we create a responsive column -->
  <div class="g-col-12 g-col-md-3">
    <select class="form-select" id="theme">
      <option value="" disabled selected>Theme</option>
      <% if (templateParams && templateParams.theme && templateParams.theme.length > 0) { %>
        <% templateParams.theme.forEach(function(theme) { %>
          <option value="<%= theme %>"><%= theme %></option>
        <% }); %>
      <% } %>
    </select>
  </div>

  <div class="g-col-12 g-col-md-3">
    <select class="form-select" id="temporalresolution">
      <option value="" disabled selected>Temporal Resolution</option>
      <% if (templateParams && templateParams.temporalresolution && templateParams.temporalresolution.length > 0) { %>
        <% templateParams.temporalresolution.forEach(function(temporalresolution) { %>
          <option value="<%= temporalresolution %>"><%= temporalresolution %></option>
        <% }); %>
      <% } %>
    </select>
  </div>

  <div class="g-col-12 g-col-md-2">
    <select class="form-select" id="geography">
      <option value="" disabled selected>Geography</option>
      <% if (templateParams && templateParams.geography && templateParams.geography.length > 0) { %>
        <% templateParams.geography.forEach(function(category) { %>
          <option value="<%= category %>"><%= category %></option>
        <% }); %>
      <% } %>
    </select>
  </div>

  <div class="g-col-12 g-col-md-2">
    <select class="form-select" id="datatype">
      <option value="" disabled selected>Data Type</option>
      <% if (templateParams && templateParams.datatype && templateParams.datatype.length > 0) { %>
        <% templateParams.datatype.forEach(function(datatype) { %>
          <option value="<%= datatype %>"><%= datatype %></option>
        <% }); %>
      <% } %>
    </select>
  </div>

  <!--
    The Button's column is special.
    - g-col-12: Full width on mobile.
    - g-col-md-2: Fixed width on desktop that accommodates the button nicely.
  -->
  <div class="g-col-12 g-col-md-2">
    <!--
      Add w-100 to the button itself.
      - This makes it fill its parent column. On mobile, the column is full-width, so the button becomes full-width.
      - On desktop, the column takes up the allocated space.
    -->
    <button id="resetButton" class="btn btn-primary w-100">Reset Selections</button>
  </div>
</div>

<!--- The rest of your EJS file remains the same -->
<div class="list grid">
  <% for (const item of items) { %>
    <div class="card border-1 rounded-2 g-col-12 g-col-sm-6 g-col-md-4 mb-2" <%=metadataAttrs(item) %>>
      <p class="card-img-top"><img src="<%- item.image %>" class="thumbnail-image card-img"></p>
      <div class="card-body post-contents">
        <h5 class="no-anchor"><a href="<%- item.path %>" class="no-anchor card-title listing-title">
            <%= item.title %>
          </a></h5>
        <div class="listing-categories">
          <% if (Array.isArray(item.categories)) { %>
            <% item.categories.forEach(category=> { %>
              <div class="listing-category me-1">
                <a class="card-tag" href="/data.html#category=<%= category %>"><%= category %></a>
              </div>
              <% }) %>
                <% } %>
        </div>
        <p class="listing-description"><%- item.description %></p>
      </div>
    </div>
    <% } %>
</div>


<script>
  const DROPDOWN_IDS = ['theme', 'temporalresolution', 'geography', 'datatype'];

  // Decode all card categories once and cache them
  const allCardCategories = (function () {
    return Array.from(document.querySelectorAll('.list.grid .card')).map(card => {
      const encoded = card.getAttribute('data-categories');
      if (!encoded) return [];
      try {
        return decodeURIComponent(atob(encoded)).split(',').map(c => c.trim());
      } catch (e) {
        return [];
      }
    });
  })();

  // Count cards whose categories include every filter in the given array
  function countMatches(filters) {
    if (filters.length === 0) return allCardCategories.length;
    return allCardCategories.filter(cats =>
      filters.every(f => cats.includes(f))
    ).length;
  }

  // Update option labels and disabled state for all dropdowns based on current selections
  function updateDropdownCounts() {
    DROPDOWN_IDS.forEach(id => {
      const select = document.getElementById(id);

      // Filters from all OTHER dropdowns
      const otherFilters = DROPDOWN_IDS
        .filter(otherId => otherId !== id)
        .map(otherId => document.getElementById(otherId).value)
        .filter(v => v !== '');

      if (!select) return;
      const currentValue = select.value;
      Array.from(select.options).forEach(function (opt) {
        if (opt.value === '') return; // skip the placeholder
        const count = countMatches([...otherFilters, opt.value]);
        opt.textContent = opt.value + ' [' + count + ']';
        // Disable options with no results, but never disable the currently selected option
        opt.disabled = count === 0 && opt.value !== currentValue;
      });
    });
  }

  function applyFilters() {
    const selectedFilters = DROPDOWN_IDS
      .map(id => document.getElementById(id).value)
      .filter(v => v !== '');

    const cards = document.querySelectorAll('.list.grid .card');

    if (selectedFilters.length === 0) {
      cards.forEach(card => { card.style.display = ''; card.classList.remove('hide'); });
    } else {
      cards.forEach((card, i) => {
        card.classList.remove('hide');
        const cats = allCardCategories[i];
        card.style.display = selectedFilters.every(f => cats.includes(f)) ? '' : 'none';
      });
    }

    updateDropdownCounts();
  }

  function resetSelections() {
    DROPDOWN_IDS.forEach(id => {
      const select = document.getElementById(id);
      select.options[0].hidden = false;
      select.value = '';
    });
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
    // Reset Quarto's list.js filter so it removes the 'hide' class it applied
    Object.values(window["quarto-listings"] || {}).forEach(list => list.filter());
    applyFilters();
  }

  // Wire up dropdown events
  document.querySelectorAll('.grid select').forEach(dropdown => {
    dropdown.onchange = applyFilters;
    dropdown.addEventListener('mousedown', function () {
      this.options[0].hidden = true;
    });
  });
  document.getElementById("resetButton").onclick = resetSelections;

  // Initialise counts on page load
  updateDropdownCounts();

  // Pre-select dropdown when arriving via a themed link (e.g. #category=Climate)
  function initFromHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const match = hash.match(/[#&]category=([^&]*)/);
    if (!match) return;
    const category = decodeURIComponent(match[1]);
    for (const id of DROPDOWN_IDS) {
      const select = document.getElementById(id);
      const option = Array.from(select.options).find(o => o.value === category);
      if (option) {
        select.options[0].hidden = true;
        select.value = category;
        break;
      }
    }
    applyFilters();
  }
  initFromHash();
</script>
